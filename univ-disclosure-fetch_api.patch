+def test_unregistered_key_stops_without_leaking(env, tmp_path, capsys):
+    # HTTPError 본문은 한 번만 읽히므로 호출마다 새로 만든다
+    unregistered = _Fresh(lambda: http_error(403, gw_error("30", "등록되지 않은 서비스키")))
+    api = FakeApi(fail={op: unregistered for _, ops in fetch_api.OPS.values() for op, _ in ops})
+    rc = fetch_api.main(["--school-id", "63", "--year", "2024-2025", "--out", str(tmp_path)], opener=api)
+    err_out = capsys.readouterr().err
+    assert rc == 1 and "활용신청" in err_out and FAKE_KEY not in err_out
+    assert len(api.urls) == 12  # 첫 해에서 멈춘다(재시도하지 않는다)
+
+
+class _Fresh(list):
+    """FakeApi.fail 에 넣으면 매 호출마다 새 예외를 만든다."""
+
+    def __init__(self, make):
+        super().__init__()
+        self.make = make
+
+    def __bool__(self):
+        return True
+
+    def pop(self, i=-1):
+        return self.make()
