+def parse_xml(text: str) -> tuple[list[dict], int]:
+    """응답 XML → (item 목록, totalCount). 오류 응답이면 ApiError(reason 코드 포함)."""
+    try:
+        root = ET.fromstring(text)
+    except ET.ParseError as e:
+        raise ApiError(f"XML 이 아니다: {text[:200]!r}") from e
+    if root.tag == "OpenAPI_ServiceResponse":  # 게이트웨이 오류 (키 미등록, 한도 초과 등)
+        code = root.findtext(".//returnReasonCode", "")
+        msg = root.findtext(".//returnAuthMsg", "") or root.findtext(".//errMsg", "")
+        err = ApiError(f"게이트웨이 오류 {code}: {msg}")
+        err.reason = code
+        raise err
+    code = root.findtext("./header/resultCode", "")
+    if code not in ("00", "0"):
+        err = ApiError(f"API 오류 {code}: {root.findtext('./header/resultMsg', '')}")
+        err.reason = code
+        raise err
+    items = [{c.tag: (c.text or "").strip() for c in it} for it in root.iterfind("./body/items/item")]
+    total = int(root.findtext("./body/totalCount", "0") or 0)
+    return items, total
+
+
+class Client:
+    def __init__(self, key: str, retries: int = 3, sleep: float = 0.0, opener=None):
+        self.key, self.retries, self.sleep = key, retries, sleep
+        self.opener = opener or urllib.request.urlopen
+        self.calls = 0
+
+    def get(self, service: str, op: str, **params) -> list[dict]:
+        q = urllib.parse.urlencode({"serviceKey": self.key, "pageNo": 1, "numOfRows": 100, **params})
+        url = f"{BASE}/{service}/{op}?{q}"
+        last = None
+        for attempt in range(self.retries + 1):
+            self.calls += 1
+            try:
+                with self.opener(url, timeout=TIMEOUT) as resp:
+                    text = resp.read().decode("utf-8", "replace")
+                items, _ = parse_xml(text)
+                if self.sleep:
+                    time.sleep(self.sleep)
+                return items
+            except urllib.error.HTTPError as e:
+                body = e.read().decode("utf-8", "replace")
+                reason = None
+                try:  # 403 등도 본문에 게이트웨이 오류 XML 이 온다
+                    parse_xml(body)
+                except ApiError as ae:
+                    reason = getattr(ae, "reason", None)
+                    last = ae
+                if reason is not None:  # 게이트웨이 오류 코드로 판단
+                    if reason not in RETRY_REASON:
