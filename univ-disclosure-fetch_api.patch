+def service_key() -> str:
+    key = os.environ.get(ENV_KEY, "").strip()
+    if not key:
+        raise ApiError(f"환경 변수 {ENV_KEY} 가 비어 있다. 공공데이터포털 인증키를 넣어라(값은 출력하지 않는다)")
