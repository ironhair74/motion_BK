+    row = {"학교ID": school["학교ID"], "학교명": school.get("학교명", ""), "공시년도": str(year),
+           "설립구분": school.get("설립구분", ""), "학교종류": school.get("학교종류", ""),
+           "지역": school.get("지역", ""), "본분교": school.get("본분교", "")}
+    got = False
+    for op, fields in ops:
+        try:
+            items = client.get(service, op, svyYr=year, schlId=school["학교ID"])
+        except ApiError as e:
