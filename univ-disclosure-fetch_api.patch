+def to_num(v: str):
+    v = (v or "").replace(",", "").strip()
+    try:
+        return float(v)
+    except ValueError:
+        return None
+
+
+def fmt(x) -> str:
+    if x is None:
+        return ""
+    return f"{round(x, 4):g}" if isinstance(x, float) else str(x)
+
+
+def parse_range(s: str) -> list[int]:
+    out = []
+    for part in s.split(","):
+        part = part.strip()
+        if not part:
+            continue
+        if "-" in part:
+            a, b = (int(x) for x in part.split("-", 1))
+            out += range(a, b + 1)
+        else:
+            out.append(int(part))
+    return out
+
+
+def fmt_id(x) -> str:
